; Recovery Manager Pro - Conservative_Demo.set
; Uses advanced settings: load it into a build compiled with #define RMP_SHOW_ADVANCED.
; PROPOSED demo-account profile. Every value here is a proposal by this
; project, not an observation from the reference video, and none of it is a
; recommendation for live trading. Smaller lots, wider grid, hard caps,
; emergency pause and readable fonts. Test on a demo account first.
; If your terminal rejects comment lines, delete the lines starting with ';'.
;
InpRecoveryPriority=0
InpScope=1
InpMagicList=0
InpExcludeMagics=
InpAdoptPolicy=0
InpFirstRecoveryTicket=0
InpLocking=1
InpDeleteSLTP=1
; launch only after 5 % managed drawdown instead of instantly
InpLaunchMode=1
InpLaunchDrawdown=5.0
InpOtherEAs=0
InpAllowChartClosure=0
InpCloseProfitable=1
InpDeletePending=1
InpPartialLots=0.01
InpPartialTPPoints=30
InpTPBasis=0
InpOverlapThreshold=3
InpOverlapCompare=0
InpOverlapIndex=0
InpBasketTP=0
InpBasketTPMoney=25.0
InpSignalMode=0
InpRecoveryDirs=0
InpFirstLot=0.01
InpLotMultiplier=1.2
InpGridStepPoints=300
InpStepMultiplier=1.1
InpOnePerBar=1
InpMultidirectional=0
InpMaxSlippage=30
InpMaxSpread=50
InpMaxRecoveryLot=0.10
InpMaxRecoveryCount=10
InpRecoveryMagic=9751421
InpLockMagic=9751422
InpLotRounding=0
InpCapBehavior=0
InpFirstDirection=0
InpMaxEntriesPerEvent=1
InpRelockOnImbalance=1
InpFullCommission=0
InpExtraCommPerLot=0.0
InpExecBufferPoints=5.0
InpNotify=1
InpPanelOpensRecovery=0
InpManualLot=0.01
InpConfirmActions=1
InpTheme=0
InpAnnotations=1
InpPanelSize=1
InpFontSize=8
InpShowCloseLine=1
InpShowGridLevels=1
InpDrawConnectors=1
InpApplyChartColors=0
InpPanelX=8
InpPanelY=22
InpShowAccountBlock=1
InpTrendTF=0
InpTrendAmplitude=4
InpTrendFirst=0
InpTrendNext=0
InpExtIndicator=
InpExtBuyBuffer=0
InpExtSellBuffer=1
InpMaxManagedLots=1.0
InpMaxRecoveryLotsSum=0.50
InpMinFreeMargin=0.0
InpMinMarginLevel=300.0
; emergency: pause automation at 15 % managed loss (still acts while paused)
InpEmergencyMode=2
InpEmergencyValue=15.0
InpEmergencyAction=0
InpEmergencyOverPause=1
InpDailyLossLimit=0.0
InpSessionStartHour=0
InpSessionEndHour=24
InpStaleQuoteSeconds=60
InpAuditCsv=1
InpInstanceId=1
InpManualOriginalMagic=0
InpEnableTestSeeds=0
InpTestSeedScenario=0
InpTestSeedLots=0.10
InpTestSeedBar=5
InpTestSeedMagic=12345
;
; --- 11-12. Three-MA normal strategy (added later; RECOVERY_ONLY keeps them inactive)
InpOperatingMode=0
InpRecoveryTriggerMode=0
InpRecoveryTriggerScope=0
InpAutoResumeAfterRecovery=1
InpResumeCooldownBars=3
InpRequireFreshSignalAfterRecovery=1
InpCombinedAdoptOthers=0
InpNormalMagic=7351001
InpSignalTF=0
InpFastPeriod=10
InpFastMethod=1
InpFastPrice=0
InpSlowPeriod=30
InpSlowMethod=1
InpSlowPrice=0
InpUseFilterMA=1
InpFilterPeriod=100
InpFilterMethod=0
InpFilterPrice=0
InpNormalDirs=0
InpNormalOneBasket=1
InpNormalLotMode=0
InpNormalLot=0.01
InpNormalLotPerBalance=1000.0
InpNormalAveraging=0
InpNormalAvgStepPoints=300
InpNormalAvgMultiplier=1.5
InpNormalMaxPerDir=5
InpNormalMaxLots=1.0
InpNormalTPPoints=200
InpNormalOverlap=0
InpNormalOverlapMinOrders=3
InpNormalOverlapTPPoints=50
InpNormalSlippage=30
; --- 13. Distance units: explicitly migrated to config version 2 (standardized points).
;     Values above were written for 5-digit Forex, where 1 standardized point = 1 broker point,
;     so every price distance is unchanged. On XAUUSD, 100 = 1.00 price on 2- and 3-digit quotes.
InpConfigVersion=2
InpDistanceUnitMode=0
InpCustomUnitPrice=0.0
InpSymbolProfileMap=GOLD:XAUUSD
InpSymbolPrefix=
InpSymbolSuffix=
InpUnitOverrides=
InpApplyUnitsToActiveCycle=0
InpWriteMigrationPreview=1
;
; ---- keys added with the 25-setting restructure; these values keep this preset's previous behaviour
InpSpacingMode=1
InpNormalTPATR=1.0
InpNormalAvgATR=1.5
InpGridATR=1.5
InpATRPeriod=14
InpPartialTPATR=0.3
InpNormalOverlapATR=0.3
InpFreezeDDPct=0.0
InpFreezeResumePct=0.0
InpEmergencyAutoResume=0
InpEmergencyCooldownBars=24
InpShowUnitsPanel=1
InpSignalConfirmBars=0
InpCrossFinance=0
InpCrossFinanceDDPct=10.0
InpPauseAllowsHedge=0
InpRecoveryMATrend=0
InpRecBasketStopPct=0.0
