; Recovery Manager Pro - Three_MA_With_Recovery.set
; EXAMPLE settings for THREE_MA_WITH_RECOVERY. Every value is a test/demo input chosen by
; this project - not the reference Three-MA EA's defaults and not a trading recommendation.
; Handover: managed-strategy floating drawdown >= 10 % of balance (InpLaunchDrawdown, unit
; InpRecoveryTriggerMode). InpLaunchMode is ignored in this mode. Emergency-loss limit 25 %
; closes everything and requires an operator reset. Test on a demo account first.
; If your terminal rejects comment lines, delete the lines starting with ';'.
;
InpRecoveryPriority=0
InpScope=0
InpMagicList=0
InpExcludeMagics=
InpAdoptPolicy=0
InpFirstRecoveryTicket=0
InpLocking=1
InpDeleteSLTP=1
InpLaunchMode=0
InpLaunchDrawdown=10.0
InpOtherEAs=0
InpAllowChartClosure=0
InpCloseProfitable=0
InpDeletePending=1
InpPartialLots=0.01
InpPartialTPPoints=30
InpTPBasis=0
InpOverlapThreshold=3
InpOverlapCompare=0
InpOverlapIndex=0
InpBasketTP=0
InpBasketTPMoney=25.0
InpSignalMode=0
InpRecoveryDirs=0
InpFirstLot=0.01
InpLotMultiplier=1.2
InpGridStepPoints=300
InpStepMultiplier=1.1
InpOnePerBar=1
InpMultidirectional=0
InpMaxSlippage=30
InpMaxSpread=50
InpMaxRecoveryLot=0.10
InpMaxRecoveryCount=10
InpRecoveryMagic=9751421
InpLockMagic=9751422
InpLotRounding=0
InpCapBehavior=0
InpFirstDirection=0
InpMaxEntriesPerEvent=1
InpRelockOnImbalance=1
