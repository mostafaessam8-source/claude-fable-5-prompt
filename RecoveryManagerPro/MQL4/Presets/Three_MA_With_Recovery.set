InpPanelY=22
InpShowAccountBlock=1
InpTrendTF=0
InpTrendAmplitude=4
InpTrendFirst=0
InpTrendNext=0
InpExtIndicator=
InpExtBuyBuffer=0
InpExtSellBuffer=1
InpMaxManagedLots=1.0
InpMaxRecoveryLotsSum=0.50
